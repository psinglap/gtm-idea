# Copy to .env and fill in. All optional for the M1 slice — it runs without keys
# (GitHub unauthenticated rate limit is low; ICP falls back to a heuristic without Claude).

# ---- Models — set as MANY as you want; the bake-off compares them -----------
# Each has a free tier. Fill any/all, then: python scripts/bench.py <url>  (ranks them).
GROQ_API_KEY=          # console.groq.com      (Llama 3.3 70B, fast)
GEMINI_API_KEY=        # aistudio.google.com   (Gemini 2.0 Flash; GOOGLE_API_KEY also works)
CEREBRAS_API_KEY=      # cloud.cerebras.ai     (Llama 3.3 70B, very fast)
OPENROUTER_API_KEY=    # openrouter.ai         (defaults to a free model)
MISTRAL_API_KEY=       # console.mistral.ai
TOGETHER_API_KEY=      # api.together.ai

# Default provider for single-shot POST /intelligence. "auto" = best available.
WG_LLM_PROVIDER=auto
WG_LLM_MODEL=          # optional: force a model id for the SELECTED provider
WG_ENABLE_OLLAMA=      # set to 1 to include local Ollama in the bake-off (run `ollama serve`)

# Paid (later / startup credits): Anthropic Claude
ANTHROPIC_API_KEY=
WG_CLAUDE_MODEL=claude-sonnet-4-6

# ---- Data / search (Step 1 uses Tavily optionally; Apollo is for later discovery) ----
# Tavily — web-search grounding to verify competitors (free 1,000/mo). Key: tavily.com
TAVILY_API_KEY=
# Firecrawl — JS-rendering crawler for SPA sites (free ~500 credits). Key: firecrawl.dev
FIRECRAWL_API_KEY=
# Apollo — company + people discovery (free ~100 emails/mo). Used in the next step. Key: apollo.io
APOLLO_API_KEY=

# GitHub — raises the GitHub API rate limit (60/hr -> 5000/hr). Create a fine-grained PAT (read-only).
GITHUB_TOKEN=

# Storage. "sqlite" needs zero infra (default). "polyglot" will use Postgres+Neo4j (not yet wired).
WG_STORE=sqlite
WG_DB_PATH=warmgraph.db

# ---- Event outreach: Luma -> LinkedIn -> Apollo -> Gmail --------------------
# Full walkthrough of every account and key: see SETUP.md

# Database. "sqlite" needs zero infra and is fine for trying it out. A real deployment wants
# Postgres, because the browser extension, the API and the cron all talk to the same one.
#   WG_STORE=postgres
#   DATABASE_URL=postgresql://...        (Neon: use the POOLED connection string)

# OPTIONAL. Encrypts stored credentials (Gmail refresh token, Apollo key). Leave blank and the
# server generates one on first boot and stores it — nothing to set up. Setting it here is the
# stronger option: the key then lives somewhere the database does not.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER change this on a running install — every stored credential becomes undecryptable.
WG_SECRET_KEY=

# Gmail connection (capability only — NOT a sign-in; the mailbox is never read).
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID -> Web application.
# Scope used: gmail.compose (covers drafts AND sending), plus openid+email. No restricted scopes.
WG_GOOGLE_CLIENT_ID=
WG_GOOGLE_CLIENT_SECRET=
WG_GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
# Which mailbox to connect. Without it Google picks whichever account the browser
# happens to be signed into — which is how you connect the wrong address.
WG_GMAIL_ACCOUNT=

# Delivery. "draft" leaves messages in Gmail Drafts for review; "send" sends them.
# Leave it on draft until you have read what it produces.
WG_OUTREACH_MODE=draft
WG_OUTREACH_DAILY_CAP=200      # messages per day
WG_OUTREACH_HOURLY_CAP=30      # paced, so 200 don't leave in one burst (deliverability)

# Apollo lookups per run — your spend ceiling. Roughly 1 in 7 becomes a sendable address, so
# this comfortably outruns the daily send cap. Raise it and you will burn credits faster than
# you can mail the results.
WG_ENRICH_LIMIT=1000

# --- Schedule ---------------------------------------------------------------
# The master switch. 0 = nothing automatic runs; use the UI button or --force.
WG_SCHEDULER=1
# Run the schedule inside the API process as well as (or instead of) a separate cron service.
# Off by default: a cron service is the better shape. Turn it on if you have no cron service,
# or want the API to catch up a slot it missed while it was down. Both is safe — they share a
# 45-minute lease in the database, so only one does the work.
WG_IN_PROCESS_SCHEDULER=0
# Slots for the in-process scheduler, UTC, comma separated. Blank = 15:00,18:00,21:00,23:00
# (8am/11am/2pm/4pm US Pacific in summer). UTC does not follow daylight saving.
# The separate cron service uses its host's cron expression instead, not this.
WG_RUN_AT_UTC=

# --- Browser worker budgets (the extension enforces these) ------------------
WG_LINKEDIN_DAILY_CAP=200      # profile reads/day. Start here; raise toward 500 once clean.
WG_EVENT_REGISTER_CAP=25       # Luma registrations/day (free events only, ever)
WG_EVENT_HORIZON_DAYS=14       # only register for events starting within this many days

# Which city's Luma discovery feed to read. DEFAULTS TO SAN FRANCISCO.
# To find yours: open luma.com/<your-city> and grep the page source for "discplace-".
WG_LUMA_DISCOVER_PLACE=

# How far back to write to people from an event you attended. Blank = 14 days.
# Guest lists are collected exactly as far back as you are willing to write.
WG_MAX_EVENT_AGE_DAYS=

# The email itself is NOT configured here — you write it once in the app (Event Outreach ->
# template), calendar link and all, and it is stored per workspace. The shipped template is a
# placeholder and the app REFUSES TO SEND until you replace it.
